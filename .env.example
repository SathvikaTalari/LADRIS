# =============================================================================
# LADRIS — Environment Configuration
# On fresh clone: copy this file to .env (no changes needed for local dev)
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# NEVER commit the real .env file to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=LADRIS
APP_VERSION=0.1.0

# ─── PostgreSQL / PostGIS ────────────────────────────────────────────────────
# Docker runs PostGIS on port 15432 to avoid conflict with any local Postgres.
# If you're NOT using Docker and have local Postgres on 5432, change the port.
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=ladris
POSTGRES_USER=ladris_user
POSTGRES_PASSWORD=landpulse_pass

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=01fd109a6c2887b1253cf7d8d77b4a1149f1bfeb38a22750ef7b137b4d5aa060
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BCRYPT_ROUNDS=12

# ─── Backend Server ───────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ─── ML Artifacts (LightGBM model inside land-delay-predictor/) ──────────────
# These paths are relative to the project root. Do NOT change unless you move files.
ML_MODULE_PATH=./land-delay-predictor/app
MODELS_DIR=./land-delay-predictor/models
ML_PREDICTION_STALE_HOURS=24

# ─── Email & Notifications (SMTP) ─────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD blank for local dev (email feature disabled).
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@ladris.gov.in
SMTP_FROM_NAME=LADRIS Delay Intelligence
SMTP_USE_TLS=true
APP_FRONTEND_URL=http://localhost:5173
DEFAULT_ALERT_EMAIL=officer@ladris.gov.in

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=LADRIS
VITE_APP_VERSION=0.1.0
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# ─── Demo Admin Seed Account ─────────────────────────────────────────────────
# IMPORTANT: Must match admin@ladris.gov.in — the primary demo login credential.
FIRST_ADMIN_EMAIL=admin@ladris.gov.in
FIRST_ADMIN_PASSWORD=Password123!
FIRST_ADMIN_NAME=System Administrator
